---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Início">
  <div class="space-y-10">
    
    <!-- Hero / Apresentação -->
    <div class="space-y-4">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight">
        Descubra o melhor <span class="text-brandBlue">setup</span>.
      </h1>
      <p class="text-textMuted text-lg max-w-2xl">
        Análises diretas e sem enrolação sobre hardware, periféricos e acessórios para programadores e gamers.
      </p>
    </div>

    <!-- Seção de Últimos Posts com Cards Visuais -->
    <div class="space-y-6">
      <h2 class="text-2xl font-bold border-b border-darkBorder pb-3">Últimos Reviews</h2>
      
      <div class="grid gap-8 md:grid-cols-2">
        {sortedPosts.map((post) => (
          <a 
            href={`/blog/${post.id}`} 
            class="bg-darkCard border border-darkBorder rounded-xl overflow-hidden hover:border-brandBlue transition-all duration-300 flex flex-col group shadow-lg"
          >
            <!-- Imagem de Capa do Card -->
            <div class="relative h-48 overflow-hidden bg-darkBg">
              <img 
                src={post.data.image} 
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 right-3 bg-darkBg/90 backdrop-blur-md px-3 py-1 rounded-full border border-darkBorder text-yellow-400 font-bold text-sm shadow-md">
                ⭐ {post.data.rating}
              </div>
            </div>

            <!-- Conteúdo do Card -->
            <div class="p-6 flex flex-col flex-grow justify-between space-y-4">
              <div>
                <span class="text-xs text-textMuted block mb-2">
                  {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
                </span>
                <h3 class="text-xl font-bold text-textMain group-hover:text-brandBlue transition-colors mb-2 leading-snug">
                  {post.data.title}
                </h3>
                <p class="text-textMuted text-sm line-clamp-2">
                  {post.data.description}
                </p>
              </div>
              <div class="text-sm font-semibold text-brandBlue flex items-center pt-2">
                Ler review completo <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>
</Layout>