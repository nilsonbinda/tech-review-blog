---
const { href, text = "Ver Preço com Desconto" } = Astro.props;
---
<div class="my-8 flex justify-center">
  <a 
    href={href} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="bg-brandBlue hover:bg-blue-600 text-white font-extrabold text-lg py-4 px-10 rounded-xl shadow-[0_0_20px_rgba(0,112,243,0.3)] hover:shadow-[0_0_30px_rgba(0,112,243,0.6)] transition-all duration-300 transform hover:-translate-y-1 w-full sm:w-auto text-center"
  >
    🛒 {text}
  </a>
</div>