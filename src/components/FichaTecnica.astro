<div class="my-8 bg-darkCard border border-darkBorder rounded-2xl p-6 shadow-xl overflow-x-auto">
  <div class="flex items-center space-x-2 mb-4 border-b border-darkBorder pb-3">
    <span class="text-2xl">📊</span>
    <h3 class="text-xl font-bold text-textMain">Especificações Técnicas</h3>
  </div>

  <!-- O <slot /> renderiza o contéudo Markdown (a tabela) repassado internamente -->
  <div class="prose prose-invert max-w-none 
              [&>table]:w-full [&>table]:text-left [&>table]:border-collapse
              [&>table_th]:bg-darkBg [&>table_th]:p-3 [&>table_th]:text-brandBlue [&>table_th]:font-bold [&>table_th]:border-b [&>table_th]:border-darkBorder
              [&>table_td]:p-3 [&>table_td]:border-b [&>table_td]:border-darkBorder/60 [&>table_td]:text-textMain [&>table_td]:text-sm
              [&>table_tr:hover]:bg-darkBg/50 transition-colors">
    <slot />
  </div>
</div>